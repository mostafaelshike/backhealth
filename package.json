{
  "name": "medical-market-backend",
  "version": "1.0.0",
  "description": "Comprehensive Express & MongoDB RESTful API with Cloudinary, JWT Authentication, and RBAC for Souq Tibbi (Medical Market)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seeder/seed.js",
    "seed:destroy": "node src/seeder/seed.js -d",
    "test:database": "node --test tests/database.test.js",
    "test:enterprise": "node tests/enterprise.test.js",
    "loadtest": "node production-load-test.js"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "cloudinary",
    "jwt",
    "medical-market",
    "ecommerce",
    "angular"
  ],
